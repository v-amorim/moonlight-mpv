+-- Local patch: walk the tree with the mouse alone, the way a native context menu
+-- does. `key` names the pending transition, so hovering the same target again
+-- does not restart its timer, and hovering anything else cancels it.
+---@param key string|nil
+---@param delay? number
+---@param action? fun()
+function Menu:schedule_hover(key, delay, action)
+	if self.hover_key == key then return end
+	self.hover_key = key
+	if self.hover_timer then
+		self.hover_timer:kill()
+		self.hover_timer = nil
+	end
+	if not key then return end
+
+	-- Only act once the pointer settles: a cursor still travelling is on its way
+	-- somewhere else, and opening under it is what makes hover navigation feel
+	-- like it fires at random.
+	local settle_distance = 8 * state.scale
+	local x, y = cursor.x, cursor.y
+	local function fire()
+		if not (self:is_alive() and self.mouse_nav and self.hover_key == key) then return end
+		local dx, dy = cursor.x - x, cursor.y - y
+		if dx * dx + dy * dy > settle_distance * settle_distance then
+			x, y = cursor.x, cursor.y
+			self.hover_timer = mp.add_timeout(delay, fire)
+			return
+		end
+		action()
+	end
+	self.hover_timer = mp.add_timeout(delay, fire)
 end
 
