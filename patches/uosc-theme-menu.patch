 local Element = require('elements/Element')
+
+-- Moonlight rows: the current item on surface-3 in primary-70, the cursor row on
+-- surface-2 (surface-4 when it is also the current item), muted icons and meta,
+-- and a hint that names a key drawn as keycaps.
+local moon = {
+	s2 = serialize_rgba('1C2033').color,
+	s3 = serialize_rgba('252A42').color,
+	s4 = serialize_rgba('2F3654').color,
+	bg = serialize_rgba('0D0E17').color,
+	p70 = serialize_rgba('A2B0EA').color,
+	muted = serialize_rgba('9BA3C4').color,
+	text = serialize_rgba('EEEEFA').color,
+	s1 = serialize_rgba('141726').color,
+	hairline = serialize_rgba('242839').color,
+}
+local KEY_NAMES = {
+	ENTER = 'Enter', ESC = 'Esc', SPACE = 'Space', TAB = 'Tab', BS = 'Bksp', DEL = 'Del', INS = 'Ins', HOME = 'Home',
+	END = 'End', PGUP = 'PgUp', PGDWN = 'PgDn', UP = '↑', DOWN = '↓', LEFT = '←', RIGHT = '→', MENU = 'Menu',
+	SHARP = '#', CTRL = 'Ctrl', ALT = 'Alt', SHIFT = 'Shift', META = 'Win',
+}
+
+-- "CTRL+o" -> {"Ctrl", "O"}; nil when the hint is not a key, such as a time or a count.
+local function key_parts(hint)
+	if not hint or hint == '' or hint:find('%s') then return nil end
+	local parts = {}
+	for part in (hint .. '+'):gmatch('(.-)%+') do parts[#parts + 1] = part end
+	if #parts == 0 or parts[#parts] == '' then return nil end
+	for i = 1, #parts - 1 do
+		if not ({CTRL = 1, ALT = 1, SHIFT = 1, META = 1})[parts[i]:upper()] then return nil end
+	end
+	local key = parts[#parts]
+	local is_key = #key == 1 or key:upper():match('^F%d%d?$') or key:upper():match('^KP%d$') or KEY_NAMES[key:upper()]
+	if not is_key then return nil end
+	for i, part in ipairs(parts) do
+		parts[i] = KEY_NAMES[part:upper()] or (#part == 1 and part:upper()) or part:upper():match('^KP(%d)$') and 'Num ' .. part:sub(3) or part
+	end
+	return parts
+end
+
+local KEYCAP_PAD, KEYCAP_GAP = 6, 4
+
+-- The Moonlight toast's shadow, 8 px down and blurred 14 px. Written by hand
+-- because ass:rect forces \blur0, which leaves a hard ledge on bright video.
+local function soft_shadow(ass, ax, ay, bx, by)
+	local s = state.scale
+	ass:new_event()
+	ass:append(string.format('{\\pos(0,0)\\rDefault\\an7\\bord0\\shad0\\blur%d\\1c&H000000&%s}',
+		round(14 * s), ass.opacity(nil, 0.62)))
+	ass:draw_start()
+	ass:round_rect_cw(ax, ay + round(8 * s), bx, by + round(8 * s), 12 * s)
+	ass:draw_stop()
+end
+
+-- The hovered entry's hint as a card above the timeline, away from the menu: the
+-- description, then its command muted on a line of its own. Sized to its text and
+-- read from the left, as the toast is; only the card itself sits centred.
+local function hint_caption(ass, text, size, small)
+	local s = state.scale
+	local desc, cmd = text:match('^(.-)%s+\xC2\xB7%s+(.+)$')
+	local lines = {{text = desc or text, size = size, color = moon.text}}
+	if cmd then lines[2] = {text = cmd, size = small, color = moon.muted} end
+	local pad, widest, height = round(14 * s), 0, 0
+	for _, line in ipairs(lines) do
+		widest = math.max(widest, text_width(line.text, {size = line.size}))
+		height = height + round(line.size * 1.4)
+	end
+	local w, h = widest + 2 * pad, height + 2 * pad
+	local ax = clamp(round(8 * s), round((display.width - w) / 2), display.width - w - round(8 * s))
+	local ay = display.height - round(150 * s)
+	soft_shadow(ass, ax, ay, ax + w, ay + h)
+	ass:rect(ax, ay, ax + w, ay + h, {
+		color = moon.s1, radius = 12 * s, border = math.max(1, round(s)), border_color = moon.hairline,
+	})
+	local y = ay + pad
+	for _, line in ipairs(lines) do
+		local lh = round(line.size * 1.4)
+		ass:txt(ax + pad, y + lh / 2, 4, ass_escape(line.text), {size = line.size, color = line.color})
+		y = y + lh
+	end
+end
+
+local function keycaps_width(parts, opts, scale)
+	local width = 0
+	for _, part in ipairs(parts) do width = width + text_width(part, opts) + 2 * KEYCAP_PAD * scale end
+	return width + (#parts - 1) * KEYCAP_GAP * scale
+end
 
