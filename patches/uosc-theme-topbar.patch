 local Element = require('elements/Element')
+
+-- Local patch: the Moonlight toast's shadow, 8 px down and blurred 14 px. Written
+-- by hand because ass:rect forces \blur0, which leaves a hard ledge on bright video.
+-- Local patch: the bar's drawn bottom edge, so the toast and the Paused card can sit
+-- below it; published only when it changes, since render runs on every pointer move.
+local published_bottom
+local function publish_bottom(value)
+	if value == published_bottom then return end
+	published_bottom = value
+	mp.set_property_native('user-data/moonlight/top_bar_bottom', value)
+end
+
+local function soft_shadow(ass, ax, ay, bx, by, opacity)
+	local s = state.scale
+	ass:new_event()
+	ass:append(string.format('{\\pos(0,0)\\rDefault\\an7\\bord0\\shad0\\blur%d\\1c&H000000&%s}',
+		round(14 * s), ass.opacity(nil, 0.62 * opacity)))
+	ass:draw_start()
+	ass:round_rect_cw(ax, ay + round(8 * s), bx, by + round(8 * s), 12 * s)
+	ass:draw_stop()
+end
 
